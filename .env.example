# Copy this file to .env.local and fill in real values.
# Never commit .env.local or real secrets.

# Google Gemini API key — powers the Reme AI chatbot
GOOGLE_AI_API_KEY=

# Supabase project URL (safe to expose client-side)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (safe to expose client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server-side only, full DB access, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Max number of free deals offered in the Your Castle signup promo
YOURCASTLE_FREE_DEAL_LIMIT=20

# Telegram bot used to notify on new contact/signup form submissions
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Unused/dead: present in .env.local but no longer referenced in code after
# @fal-ai/client was removed as an unused dependency. Safe to delete once
# confirmed nothing else depends on it.
FAL_KEY=
