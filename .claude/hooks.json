{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/Users/michaelkraft/done-deal-site/.nightagent/hooks/pre-edit.sh\" \"$TOOL_INPUT_FILE_PATH\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/Users/michaelkraft/done-deal-site/.nightagent/hooks/on-edit.sh\" \"$FILE_PATH\"",
            "timeout": 60000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "agent",
            "prompt": "Before stopping, run `npm test --if-present` and `npm run lint --if-present`. If either fails, fix the issues and try again. Only stop when all tests pass or you have documented the failures in NIGHTAGENT_REPORT.md.",
            "timeout": 300000
          }
        ]
      }
    ]
  }
}